{
  "format": 1,
  "description": "Manifest classifying every non-ignored source file in the authoritative local repo for public RecallDock export (fail-closed on unclassified files).",
  "include": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin/marketplace.json",
    ".gitattributes",
    ".gitignore",
    ".github/**",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "Makefile",
    "NOTICE.md",
    "PROVENANCE.md",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "assets/**",
    "cmd/**",
    "docs/GATEWAY-AUTH.md",
    "docs/GATEWAY-MCP.md",
    "docs/HOST-ADAPTERS.md",
    "docs/INSTALLATION.md",
    "docs/LOCAL-QUICKSTART.md",
    "docs/MEMORY-CLASSES.md",
    "docs/PRIVACY.md",
    "docs/RELEASE.md",
    "docs/USER-GUIDE.md",
    "docs/WINDOWS.md",
    "go.mod",
    "go.sum",
    "integrations/**",
    "internal/**",
    "plugin/**",
    "public-export-manifest.json",
    "testdata/**",
    "tools/**"
  ],
  "exclude": [
    ".recalldock/**",
    "AGENTS.md",
    "CLAUDE.md",
    "MAINTENANCE.md",
    "PLAN-CHECKLIST.md",
    "docs/ACCEPTANCE-0323.md",
    "docs/CORE-COMPLETION.md",
    "docs/NEXT-ARCHITECTURE.md",
    "docs/REVISION-HISTORY.md"
  ]
}
